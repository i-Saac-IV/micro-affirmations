	(text "V_{OUT}	= V_{ADJ} * (1 + R_{1}/R_{2})\n\nAssuming\n	V_{ADJ} = 0.8V (from specs)\n	R_{2} = 10k\n\nR_{1} = (V_{OUT} / V_{ADJ} - 1) * R_{2}\n\nV_{OUT} = 3.3V ==> R_{1} = 31.25k\nV_{OUT} = 3.6V (STM32 V_{max}) ==> R_{1} = 35k"
		(exclude_from_sim no)
		(at 129.794 54.356 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f391b1e1-13d8-4cd6-abf5-45476890d81a")
	)
